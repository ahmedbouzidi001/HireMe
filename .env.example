# ==========================================
# FIREBASE CONFIGURATION
# ==========================================
# Firebase configuration is loaded from firebase-applet-config.json
# No need to set here - configure via Firebase Console

# ==========================================
# SERVERLESS API CONFIGURATION
# ==========================================
# REACT_APP_FUNCTIONS_URL: URL of your Firebase Cloud Functions
# Format: https://<region>-<projectId>.cloudfunctions.net
# Example: https://us-central1-hiremeai.cloudfunctions.net
REACT_APP_FUNCTIONS_URL="https://us-central1-hiremeai.cloudfunctions.net"

# ==========================================
# GEMINI AI API (FOR CLOUD FUNCTIONS ONLY)
# ==========================================
# IMPORTANT: GEMINI_API_KEY is ONLY for Cloud Functions backend
# NEVER expose this to the browser/client
# Set this in Firebase Cloud Functions environment variables
# DO NOT add to client-side code
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_FOR_CLOUD_FUNCTIONS_ONLY"

# ==========================================
# STRIPE CONFIGURATION (OPTIONAL)
# ==========================================
# For payment processing - backend validation only
STRIPE_SECRET_KEY="YOUR_STRIPE_SECRET_KEY_FOR_BACKEND"
STRIPE_PUBLISHABLE_KEY="YOUR_STRIPE_PUBLIC_KEY_FOR_CLIENT"

# ==========================================
# DEPRECATED - NO LONGER USED
# ==========================================
# Supabase is deprecated in favor of Firebase
# VITE_SUPABASE_URL=""
# VITE_SUPABASE_ANON_KEY=""
